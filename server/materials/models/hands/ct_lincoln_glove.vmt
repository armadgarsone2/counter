"VertexLitGeneric"
{
	"$basetexture"		"models/hands/ct_lincoln_glove"
	"$bumpmap"		"models/hands/ct_lincoln_glove_normal"
	"$envmap"		"env_cubemap"
	"$envmaptint"		"[ 0.200000 0.200000 0.200000 ]"
	"$envmapcontrast"	0.250000
	"$envmapsaturation"	0.100000
	"$envmapboost"		0.25000
	"$phongexponent"	6.000000
	"$phongboost"		0.60000
	"$phong"		1
	"$bumpscale"		1.000000

	"$rimlight"		1
	"$rimlightexponent"	2.000000
	"$rimlightboost"	0.2000000
	"$rimlightcolorblend"	1.0
	"$rimmask"		0

	"$normalmapalphaenvmapmask" 1
	"$specularmask" "255"
        "$diffusecontrast"  0.25

	 //$translucent  1
	 //$nocull 1
	 //$alphatest 1
	 //$ALPHATESTREFERENCE	0.1

//========================================반사 환경맵 관련===================================
//	"$envmaptint" "[ 0.08 0.08 0.08 ]"
// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phongtint" "[1 1 1]"	           // 퐁효과에 더해질 (R,G,B)값
//	"$phongfresnelranges"	"[0.36 0.36 0.36]"

//=================림라이트(스폿라이트와 상관없이 지속적으로 표시되는 림라이트)==============
$usegeneralattr 1
$UseModelLight   1

	$ShadowSilouette	0
	$usecharacterfog	1
}