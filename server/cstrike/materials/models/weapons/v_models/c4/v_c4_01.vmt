"VertexLitGeneric"
{
	"$basetexture"	"models\weapons\v_models\c4\v_c4_01"

	"$bumpmap" "models\weapons\v_models\c4\v_c4_01_normal"

	"$envmap" "env_cubemap"
        "$normalmapalphaenvmapmask" 1
	"$envmaptint"		"[ 0.500000 0.500000 0.500000 ]"
	"$envmapcontrast"	0.20000
	"$envmapsaturation"	0.500000
	"$envmapboost"		0.3000	
		
	"$rimlight"		1
	"$rimlightexponent"	2.000000
	"$rimlightboost"	0.2000000
	"$rimlightcolorblend"	1.000000
	"$rimmask"		0

        "$surfaceprop" metal

        "$phong" 		 1   // [빛에 의한 실시간 빛 반사]
        "$phongexponent" 	10   // [퐁의 양?]
	"$phongboost" 20            // [명도효과]
         $UseModelLight   1
           
	$usecharacterfog	1
} 